    "/api/v1/detections/{detection_id}/plate-crop": {
      "get": {
        "tags": [
          "detections"
        ],
        "summary": "Get Plate Crop",
        "description": "Serve the plate crop kept as review evidence.\n\nBoth variants exist so a reviewer can judge the geometry stage, not just its output:\n'after' is missing when the corners could not be recovered and no warp was applied.",
        "operationId": "get_plate_crop_api_v1_detections__detection_id__plate_crop_get",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "detection_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Detection Id"
            }
          },
          {
            "name": "variant",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "before",
                "after"
              ],
              "type": "string",
              "description": "'before' is the detector crop as found; 'after' is the same crop with the perspective removed.",
              "default": "after",
              "title": "Variant"
            },
            "description": "'before' is the detector crop as found; 'after' is the same crop with the perspective removed."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
