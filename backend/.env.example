APP_NAME=Fable Vehicle Recognition Backend
# development permits the explicitly labelled mock mode; production does not.
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
API_PORT=8000
API_KEY=CHANGE_ME_API_KEY
DOCS_ENABLED=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
# Compose overrides DATABASE_URL to use its private db service.
DATABASE_URL=postgresql+asyncpg://app:CHANGE_ME_DB_PASSWORD@localhost:5432/fable
STORAGE_DIR=./data/storage
MAX_UPLOAD_MB=25
MAX_REQUEST_MB=100
MAX_UPLOAD_FILES=25
MAX_IMAGE_PIXELS=40000000
MIN_FREE_DISK_MB=256
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# local  -> the bundled open-source pipeline; runs on this machine, no API key needed.
# mock   -> returns no detections; for wiring tests only.
# openai_compatible -> an external multimodal model server you host yourself.
VISION_PROVIDER=local
VISION_BASE_URL=http://host.docker.internal:8001/v1
VISION_API_KEY=
# Exact served model ID; Astra-6/Fable are not assumed to be API model IDs.
VISION_MODEL=
VISION_TIMEOUT_SECONDS=90
VISION_MAX_RETRIES=2
VISION_USE_RESPONSE_FORMAT=true
VISION_MAX_TOKENS=4096
VISION_MAX_IMAGE_SIDE=2560
VISION_MAX_RESPONSE_BYTES=2000000
VISION_STORE_RAW_RESPONSE=false

# --- local recognition pipeline (VISION_PROVIDER=local) ---------------------
# Weights live here. Populate with: python scripts/fetch_models.py
VISION_MODEL_DIR=./data/models
# Recorded on every job so results stay traceable to a pipeline version.
VISION_LOCAL_MODEL_ID=local-alpr-v1
# cpu is the supported default. cuda needs onnxruntime-gpu and a matching CUDA runtime.
VISION_DEVICE=cpu
# 0 lets ONNX Runtime choose; pin it when several workers share a host.
VISION_ONNX_THREADS=0
# Images inside the pipeline at once. This is what caps peak memory, not the model count.
VISION_MAX_PARALLEL_IMAGES=1
# Vehicle stage. 960 finds distant machinery that 640 misses; cost is ~0.2 s per frame.
VISION_VEHICLE_INPUT_SIZE=960
VISION_VEHICLE_THRESHOLD=0.35
# Plate stage. Tiles are run at native resolution, which is what makes ~100 px plates
# visible at all; lower the overlap to trade recall for speed.
VISION_PLATE_MODEL=yolo-v9-s-608-license-plate-end2end
VISION_PLATE_THRESHOLD=0.25
VISION_PLATE_TILE=608
VISION_PLATE_TILE_OVERLAP=0.35
VISION_PLATE_FRAME_SWEEP=true
# OCR. PP-OCR roughly triples per-frame cost and is markedly more accurate here.
VISION_OCR_MODEL=cct-s-v2-global-model
VISION_USE_PPOCR=true
VISION_OCR_ACCEPT_CONFIDENCE=0.55
# Applies to layouts inferred from samples rather than a published spec.
VISION_OCR_ACCEPT_CONFIDENCE_UNFORMATTED=0.88
VISION_READ_ATTRIBUTES=true
VISION_CYRILLIC_ATTRIBUTES=true
# --- reference gallery: machine type by similarity to reference photos -------
# COCO has no class for agricultural machinery, so a tractor arrives as "truck".
# The gallery answers that from photos you supply. Empty gallery = stage disabled.
#   python scripts/build_reference_gallery.py --report     # what is in it
#   python scripts/build_reference_gallery.py              # rebuild after adding photos
VISION_REFERENCE_GALLERY=true
VISION_REFERENCE_DIR=./data/reference
# Cosine similarity floor; below it the detector's coarse label stands.
VISION_REFERENCE_MIN_SIMILARITY=0.62
# Required gap to the runner-up class. This is what turns an ambiguous rear view into
# "no answer" instead of a coin flip. Lower it for more answers and more mistakes.
VISION_REFERENCE_MIN_MARGIN=0.04
VISION_REFERENCE_TOP_K=5
# These cameras burn a timestamp into the top of the frame; 0 disables the guard.
VISION_OVERLAY_BAND_TOP=0.045
# Keeps the plate crop before and after rectification, for review.
VISION_SAVE_PLATE_CROPS=true

# Compose uses a separate worker; local inprocess mode also uses the durable queue.
PROCESSING_MODE=inprocess
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=1
JOB_TIMEOUT_SECONDS=300
JOB_LEASE_SECONDS=360
JOB_MAX_ATTEMPTS=3
EXPORT_MAX_IMAGES=1000
